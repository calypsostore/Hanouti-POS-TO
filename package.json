{
  "name": "7anouti-pos",
  "private": true,
  "version": "1.0.12",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod-local": "npm run typecheck && vite build --mode production",
    "preview": "vite preview",
    "preview:prod": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "apk:sync": "npm run build && npx cap sync android",
    "apk:debug": "npm run apk:sync && cd android && gradlew.bat assembleDebug",
    "apk:release": "npm run apk:sync && cd android && gradlew.bat assembleRelease",
    "release:bump": "npm version patch --no-git-tag-version",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@supabase/supabase-js": "^2.119.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.78.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.1.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.4.3",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.1.4",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^5.1.1"
  }
}

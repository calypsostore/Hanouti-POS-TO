# Copy to .env in this directory and protect it with mode 0600.
# Use URL-safe hexadecimal values for secrets embedded in PostgreSQL URLs.
# Generate POSTGRES_PASSWORD, JWT_SECRET, and every other secret independently.

POSTGRES_PASSWORD=replace-with-long-random-postgres-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

JWT_SECRET=replace-with-random-secret-at-least-32-bytes
JWT_EXPIRY=3600
ANON_KEY=replace-with-a-legacy-anon-jwt-signed-by-JWT_SECRET
SERVICE_ROLE_KEY=replace-with-a-legacy-service-role-jwt-signed-by-JWT_SECRET

SUPABASE_PUBLIC_URL=https://hanouti-pos.tn
API_EXTERNAL_URL=https://hanouti-pos.tn/auth/v1
SITE_URL=https://hanouti-pos.tn
ADDITIONAL_REDIRECT_URLS=https://hanouti-pos.tn/**

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
PGRST_JWT_SECRET=

REALTIME_DB_ENC_KEY=replace-with-16-character-hex
SECRET_KEY_BASE=replace-with-long-random-secret
VAULT_ENC_KEY=replace-with-exactly-32-character-hex
PG_META_CRYPTO_KEY=replace-with-long-random-secret

DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=replace-with-long-random-dashboard-password
STUDIO_PORT=3003
STUDIO_DEFAULT_ORGANIZATION=Hanouti POS
STUDIO_DEFAULT_PROJECT=Hanouti POS

KONG_HTTP_PORT=8000

POOLER_TENANT_ID=hanouti-pos
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

STORAGE_TENANT_ID=hanouti-pos
GLOBAL_S3_BUCKET=hanouti-storage
REGION=eu-west-1
IMGPROXY_AUTO_WEBP=true

FUNCTIONS_VERIFY_JWT=false
LOGIN_RATE_LIMIT_PEPPER=replace-with-long-random-pepper
PUSH_WEBHOOK_SECRET=replace-with-64-character-random-hex
FCM_SERVICE_ACCOUNT_JSON=

DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Hanouti POS
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
